<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="0dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:background="#1A1A1A">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252525" />

    <!-- 4-Column Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:paddingHorizontal="12dp"
        android:weightSum="4">

        <!-- ============================================ -->
        <!-- COLUMN 1: LAUNCHER & APPEARANCE -->
        <!-- ============================================ -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- LAUNCHER section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LAUNCHER"
                    android:textColor="#6B8EFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Customize app behavior"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Edit Mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Edit Mode"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:paddingEnd="4dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEditMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX="0.85"
                        android:scaleY="0.85" />
                </LinearLayout>

                <!-- Show Categories -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Show Categories"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:paddingEnd="4dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX="0.85"
                        android:scaleY="0.85" />
                </LinearLayout>

                <!-- Manage Categories -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Categories"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btnManageCategories"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="#673AB7"
                    android:text="Manage Categories"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <!-- APPEARANCE section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="APPEARANCE"
                    android:textColor="#6B8EFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Themes, sizes, and opacity"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Theme -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Theme"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btnThemes"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="14dp"
                    android:backgroundTint="#9C27B0"
                    android:text="Choose Theme"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />



                <!-- Icon Size -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Icon Size"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="2dp" />

                <!-- Icon Size Range Display -->
                <TextView
                    android:id="@+id/txtIconSizeRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="82dp - 236dp (5 presets)"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:layout_marginBottom="4dp" />

                <SeekBar
                    android:id="@+id/seekIconSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50" />

                <TextView
                    android:id="@+id/txtIconSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:gravity="end"
                    android:text="125dp"
                    android:textColor="#888888"
                    android:textSize="10sp" />

                <!-- Background Opacity -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Background Opacity"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <SeekBar
                    android:id="@+id/seekBgOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="100" />

                <TextView
                    android:id="@+id/txtBgOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="100%"
                    android:textColor="#888888"
                    android:textSize="10sp" />

            </LinearLayout>
        </ScrollView>

        <!-- Column Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#252525" />

        <!-- ============================================ -->
        <!-- COLUMN 2: STARTUP & SYSTEM -->
        <!-- ============================================ -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- STARTUP section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="STARTUP"
                    android:textColor="#6B8EFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto-launch options"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Auto-start on Boot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Auto-start on Boot"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:paddingEnd="4dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutoStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX="0.85"
                        android:scaleY="0.85" />
                </LinearLayout>

                <!-- Auto-restart -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Auto-restart"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:paddingEnd="4dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/autoRestartSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX="0.85"
                        android:scaleY="0.85" />
                </LinearLayout>

                <TextView
                    android:id="@+id/autoRestartStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Disabled"
                    android:textColor="#666666"
                    android:textSize="10sp"
                    android:layout_marginBottom="20dp" />

                <!-- SYSTEM section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM"
                    android:textColor="#6B8EFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quest system controls"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Native Settings - opens Quest's Android Settings directly (no APK needed) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Native Settings"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btnNativeSettings"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#4CAF50"
                    android:text="Open"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <!-- Device Info -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Device Info"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btnDeviceInfo"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#607D8B"
                    android:text="View"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Column Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#252525" />

        <!-- ============================================ -->
        <!-- COLUMN 3: UPDATES & DATA -->
        <!-- ============================================ -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- UPDATES section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="UPDATES"
                    android:textColor="#6B8EFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check for new versions"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Current Version -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Current Version"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtCurrentVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="v2.1.1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="14dp" />

                <!-- Auto-check -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Auto-check Updates"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:paddingEnd="4dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutoUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX="0.85"
                        android:scaleY="0.85" />
                </LinearLayout>

                <!-- Check Updates -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check Now"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btnCheckUpdates"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="#2196F3"
                    android:text="Check Updates"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <!-- BACKUP & RESTORE section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BACKUP &amp; RESTORE"
                    android:textColor="#6B8EFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save or restore your settings"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <Button
                        android:id="@+id/btnBackup"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:backgroundTint="#4CAF50"
                        android:text="Backup"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:minHeight="0dp"
                        android:padding="0dp" />

                    <Button
                        android:id="@+id/btnRestore"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:backgroundTint="#FF9800"
                        android:text="Restore"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:minHeight="0dp"
                        android:padding="0dp" />
                </LinearLayout>

                <!-- STATS section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Playtime Tracker"
                    android:textColor="#6B8EFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View playtime and usage"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Game Stats -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Playtime Tracker"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <!-- Usage Access -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grant playtime tracker permissions"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btnUsageAccess"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="#FF5722"
                    android:text="Grant"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/btnGameStats"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="#9C27B0"
                    android:text="View Stats"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Column Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#252525" />

        <!-- ============================================ -->
        <!-- COLUMN 4: QUEST & APPS -->
        <!-- ============================================ -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- QUEST section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="QUEST UTILITIES"
                    android:textColor="#6B8EFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Shell commands via Shizuku"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Old UI -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quest Classic UI"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btnResetUI"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#2196F3"
                    android:text="Switch to Old UI"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <!-- Stop VrShell -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VR Shell"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btnRestartUI"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="#FF5722"
                    android:text="Stop VrShell"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <!-- APPS section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="APPLICATIONS"
                    android:textColor="#6B8EFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Install bundled APKs"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Bundled Apps -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bundled Apps"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btnBundledApps"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#9C27B0"
                    android:text="Browse Apps"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <!-- Storage Manager -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Storage Manager"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btnAppManager"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="#673AB7"
                    android:text="Manage Storage"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252525" />

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:padding="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="Close"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:textAllCaps="false"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>